# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aracne2
POSTGRES_USER=aracne2
# CHANGE in production
POSTGRES_PASSWORD=changeme_postgres

# ── eXist-db ─────────────────────────────────────────────────────────────────
EXISTDB_URL=http://existdb:8080
# Runtime user — dedicated low-privilege account created by the backend at startup.
# Must match the username passed to bootstrap_user.xq.
EXISTDB_USER=aracne
# eXist-db admin password — set manually via the eXist-db UI or REST API, then stored here.
# Used by the backend only for bootstrap operations (ensure_root, bootstrap_user).
# eXist-db starts with an empty admin password; change it before going to production.
EXIST_PASSWORD=
# Password for the runtime 'aracne' user created at bootstrap.
# REQUIRED in production — leave empty only in initial development before first startup.
# CHANGE in production.
EXISTDB_APP_PASSWORD=

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# REQUIRED — minimum 64 characters
JWT_SECRET=
JWT_ACCESS_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=30

# ── Security ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
# Production: CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]
CORS_ORIGINS=["http://localhost:5173"]

# ── Application ──────────────────────────────────────────────────────────────
# development | production | test
ENVIRONMENT=development
LOG_LEVEL=INFO
PLATFORM_NAME=Aracne2
PUBLIC_REGISTRATION=false
MAX_UPLOAD_SIZE_MB=50

# ── TEI schema storage ────────────────────────────────────────────────────────
# Directory where validation and CM5 schema files are stored.
# Development default: /app/schemas (inside the backend volume mount, no setup needed).
# Production: set to a persistent named volume path, e.g. /data/schemas,
# and add the corresponding volume mount in docker-compose.prod.yml.
SCHEMAS_DIR=/app/schemas

# ── EVT viewer (optional — requires the 'evt' Docker Compose profile) ────────
# Base URL of the EVT nginx container. In development set to the mapped port.
# In production leave empty: nginx serves /evt/ at the same origin.
VITE_EVT_BASE_URL=http://localhost:8181

# ── GeoNames (Place-of-Publication autocomplete) ─────────────────────────────
# Register a free account at https://www.geonames.org/login
GEONAMES_USERNAME=aracne

# ── Initial admin seed (used only by `make seed`) ────────────────────────────
# CHANGE immediately after first seed
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme_admin
